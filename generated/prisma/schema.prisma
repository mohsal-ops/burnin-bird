// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Admin {
  id                         String      @id @default(uuid())
  name                       String
  email                      String      @unique
  pendingEmail               String?
  passwordHash               String
  status                     AdminStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt            DateTime?
  verificationToken          String?     @unique
  verificationTokenExpiresAt DateTime?
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
}

model Item {
  id                     String      @id @default(uuid())
  name                   String
  description            String?
  priceInCents           Int
  slug                   String      @unique
  isAvailableForPurchase Boolean     @default(true)
  featured               Boolean     @default(false)
  image                  String?
  typeId                 String
  type                   Types       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  orders                 Order[]
  isCaterable            Boolean     @default(false)
  cateringDescription    String?
  cateringPriceInCents   Int?
  sideGroups             SideGroup[]
}

model User {
  id        String   @id @default(uuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Types {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Location {
  id        String   @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(uuid()) @map("_id")
  title       String
  description String
  content     String?
  image       String
  createdAt   DateTime @default(now())
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String[]
  image     String?
  order     Int      @default(0)
  accent    String   @default("#c85a1e")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String   @id @default(uuid()) @map("_id")
  pricePaidInCents Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  productId        String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Item     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  status    String     @default("open") // open/completed/abandoned

  // Uber Direct courier delivery (optional per restaurant - see SiteSetting
  // "uber_direct_enabled"). A quote is fetched at checkout; the courier is
  // dispatched after payment; status is advanced by the Uber webhook.
  uberQuoteId     String?
  uberFeeCents    Int?
  uberDeliveryId  String?
  uberStatus      String? // pending|pickup|pickup_complete|dropoff|delivered|canceled|returned
  uberTrackingUrl String?
  // Why the last Uber quote failed (Uber's own reason, or "delivery turned off").
  // Set when a delivery quote fails, cleared on success; included in the owner's
  // Telegram alert so a missing courier is diagnosable without reading code.
  uberQuoteError  String?

  // Loyalty promo code applied at checkout (the LoyaltyCampaign whose code was
  // entered). Set when the code is validated; on a completed order that campaign's
  // redemptionCount is incremented.
  promoCampaignId String?

  // Delivery router (platform build, flag "delivery_router"). Which courier
  // the quote came from: null/"uber_direct" = Uber (today's behaviour),
  // "doordash_drive" = DoorDash Drive. The uber* fields above hold the quote /
  // delivery for WHICHEVER courier was chosen (historic names, kept so the
  // existing checkout, orders and success pages work unchanged).
  deliveryProvider        String?
  deliveryQuoteExpiresAt  DateTime?
  // What the courier actually charges (uberFeeCents is what the CUSTOMER pays,
  // which can be lower when the restaurant absorbs part of the fee).
  deliveryCourierFeeCents Int?
}

model CartItem {
  id        String  @id @default(uuid())
  image     String?
  productId String?
  name      String?
  orderType String?

  pickupDay  DateTime?
  pickupTime String?

  // Delivery fields (DoorDash / Uber / etc)
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryPlaceId String?
  apt             String?
  instructions    String?
  customerName    String?
  customerPhone   String?

  price    Int?
  quantity Int?
  cartId   String
  cart     Cart           @relation(fields: [cartId], references: [id])
  sides    CartItemSide[]
}

enum SideGroupType {
  RECOMMENDED
  NO
  EXTRA
  SPICE
  SIDE
}

model SideGroup {
  id        String        @id @default(uuid())
  itemId    String
  title     String // e.g. "Burger No", "Extra Sauce"
  type      SideGroupType
  required  Boolean       @default(false)
  maxSelect Int? // null = unlimited
  order     Int           @default(0) // owner-controlled display order

  item    Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options SideOption[]

  createdAt DateTime @default(now())
}

model SideOption {
  id           String    @id @default(uuid())
  sideGroupId  String
  label        String // "No Pickles", "Golden Ranch"
  priceInCents Int? // null = free
  linkedItemId String? // for Recommended Sides (points to Item)
  order        Int       @default(0) // display order within the group
  sideGroup    SideGroup @relation(fields: [sideGroupId], references: [id], onDelete: Cascade)
}

model CartItemSide {
  id           String   @id @default(uuid())
  cartItemId   String
  sideGroupId  String
  optionId     String
  label        String
  priceInCents Int? // snapshot price at order time
  cartItem     CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  review    String
  avatar    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BusinessHours {
  id        String   @id @default(cuid())
  day       String // "Sunday", "Monday", etc.
  dayIndex  Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  open      Int? // 24h hour number, null = closed
  close     Int? // 24h hour number, null = closed
  updatedAt DateTime @updatedAt

  @@unique([dayIndex])
}

model CateringRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  eventType String
  date      String
  guests    String
  notes     String?
  status    String   @default("new") // "new" | "contacted" | "confirmed" | "declined"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique // "home_hero" | "story_hero" | "story_origin" | "story_closing"
  url       String
  label     String // human-readable label for admin UI
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id // "theme_color" | "logo_url"
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Loyalty & SMS marketing (optional add-on; gated by SiteSetting
// "loyalty_enabled"). Consent is captured at checkout and stored verbatim +
// versioned so it's provable later exactly what the customer agreed to.
model LoyaltyContact {
  id                 String    @id @default(cuid())
  projectId          String // which client site this belongs to (this site's id)
  phone              String?
  email              String?
  firstName          String?
  birthday           DateTime?
  // SMS (TCPA) and email (CAN-SPAM) are legally distinct consents - tracked
  // separately so an email-only signup never counts as an SMS opt-in.
  smsSubscribed      Boolean   @default(false)
  emailSubscribed    Boolean   @default(false)
  consentTextVersion String? // exact opt-in wording shown, versioned
  consentTimestamp   DateTime  @default(now())
  consentIp          String?
  unsubscribedAt     DateTime?
  createdAt          DateTime  @default(now())

  @@unique([projectId, phone])
  @@unique([projectId, email])
  @@index([projectId])
  @@index([phone])
  @@index([email])
}

model LoyaltyCampaign {
  id              String   @id @default(cuid())
  projectId       String
  channel         String   @default("sms") // "sms" | "email"
  message         String
  type            String // "manual_blast" | "birthday_auto"
  recipientCount  Int
  // Efficiency tracking. redemptionCode is entered at checkout to redeem the
  // offer; discountPercent is the % it takes off the items subtotal; costCents is
  // the real send cost (Brevo per-message rate * recipients, computed at send);
  // redemptionCount counts completed orders that used the code.
  redemptionCode  String?  @unique
  discountPercent Int      @default(10)
  costCents       Int?
  redemptionCount Int      @default(0)
  sentAt          DateTime @default(now())

  @@index([projectId])
}

// ── POS integration (platform build, Phase 1) ─────────────────────────────────
// All additive. Nothing reads these unless the "pos_push" / "pos_menu_sync"
// flags are on (src/lib/flags.ts). Tokens are AES-256-GCM encrypted
// (src/lib/secretBox.ts, domain "pos-creds") — never stored or logged in plain.

model PosConnection {
  id             String    @id @default(cuid())
  provider       String    @unique // "square" | "clover" | "toast" | "lightspeed_k" | "shift4"
  environment    String    @default("sandbox") // "sandbox" | "production"
  merchantId     String?
  locationId     String? // Square location / Clover has one per merchant
  credsEnc       String? // encrypted { accessToken, refreshToken, expiresAt }
  status         String    @default("disconnected") // connected | disconnected | error
  lastError      String?
  lastMenuSyncAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Maps our menu rows to POS catalog ids (items + modifier options).
model PosMenuMap {
  id         String   @id @default(cuid())
  provider   String
  localType  String // "item" | "option"
  localId    String // Item.id or SideOption.id
  posId      String // Square ITEM_VARIATION / MODIFIER id, Clover item / modifier id
  posVersion String?
  updatedAt  DateTime @updatedAt

  @@unique([provider, localType, localId])
  @@index([provider, posId])
}

// One row per paid order we try to push to the POS. cartId = our order id.
model PosOrderSync {
  id          String    @id @default(cuid())
  cartId      String
  provider    String
  status      String    @default("pending") // pending | sent | failed | manual
  posOrderId  String?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([cartId, provider])
  @@index([status, nextRetryAt])
}

// ── Web push (platform build, Phase 3; flag "web_push", OFF) ─────────────────
// A browser that agreed to notifications. audience "owner" = new-order alerts
// on the owner's phone/computer; "customer" = status of ONE order (cartId).
model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique
  p256dh        String
  auth          String
  audience      String // "owner" | "customer"
  cartId        String?
  userAgent     String?
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([audience])
  @@index([cartId])
}

// DB-backed rate limiting (lib/rateLimit.ts creates it on first use with raw
// SQL). Declared here so `prisma db push` / migrate-client-dbs never see it as
// an unknown table to drop. @@ignore: not used through the Prisma client.
model RateHit {
  key String
  at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([key, at], map: "RateHit_key_at")
  @@ignore
}
