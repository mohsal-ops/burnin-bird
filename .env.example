# Most env vars for a client site are provisioned automatically by the builder
# panel. This file documents every variable the code reads. NEVER put real
# values in this file — it is committed.

# ── Core (set by the builder panel when a site is created) ───────────────────
DATABASE_URL=                 # Neon Postgres connection string (panel creates one DB per site)
SITE_URL=                     # https://<slug>.vercel.app
NEXT_PUBLIC_SERVER_URL=       # same as SITE_URL
ADMIN_SECRET=                 # random 64 hex chars; signs admin sessions AND derives the AES-256-GCM key for stored tokens. Never change on a live site (stored tokens become unreadable).
OWNER_ALERT_EMAIL=            # restaurant owner email for new-order alerts
AGENCY_ALERT_EMAIL=           # Starvega inbox for access/lead alerts

# ── Email (nodemailer SMTP, transactional) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CATERING_EMAIL=

# ── Owner alerts ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # from @BotFather
TELEGRAM_CHAT_ID=             # owner's Telegram chat id

# ── Payments (Stripe; normally pasted in admin → Payments instead) ────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GIFTCARD_WEBHOOK_SECRET=

# ── Uploads (Cloudflare R2; the panel copies these into every project) ────────
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Uber Direct courier delivery (optional add-on; OFF unless enabled in admin)
# From the Uber Direct dashboard → Developers. Sandbox values while testing
# (Robocourier). Per-restaurant keys can also be saved in admin → Delivery
# (encrypted); these env values are the fallback for existing sites.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_STATUS_SECRET=           # must match the builder's UBER_STATUS_SECRET (central Uber webhook → /api/uber/status-callback)

# ── Loyalty & SMS marketing (optional add-on) — read LOYALTY_SMS.md ───────────
# PREREQUISITE: Brevo toll-free / Sender ID registration + "Manage US compliance"
# must be ACTIVE before any real US sending.
BREVO_API_KEY=                # Brevo → SMTP & API → API keys (shared agency account)
BREVO_SMS_SENDER=             # 3-11 char alphanumeric sender id
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_SECRET=         # ?key= on the Brevo unsubscribe webhook → /api/loyalty/webhook
BREVO_SMS_COST_CENTS=
BREVO_EMAIL_COST_CENTS=
LOYALTY_CRON_SECRET=          # n8n birthday job → /api/loyalty/birthday-run?key=<this>

# ── Analytics / maps / misc ───────────────────────────────────────────────────
GA4_PROPERTY_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_KEY=
GOOGLE_SHEET_ID=
NEXT_PUBLIC_HERE_API_KEY=
NEXT_PUBLIC_MAPS_API_KEY=
PAGESPEED_API_KEY=
PAGESPEED_SITE_URL=
NEXT_PUBLIC_BUILDER_URL=
AGENCY_REGISTRY_URL=
AGENCY_REGISTRY_SECRET=
NEON_REGION=
DEBUG_ANALYTICS=

# ── Platform build: safety switches (every new feature is OFF per site by default)
STARVEGA_KILL_ALL=            # "1" forces every new platform feature OFF on this site
# STARVEGA_KILL_POS_PUSH=1    # per-feature kill: STARVEGA_KILL_<FLAG NAME IN CAPS>
